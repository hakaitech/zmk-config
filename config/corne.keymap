/*
 * Corne (crkbd) macropad keymap.
 *
 * Five layers, switched with a held picker thumb. Every position of every layer is
 * written out: there is deliberately NO transparent key anywhere, so nothing falls
 * through to the default layer underneath (scripts/lint-keymap.sh enforces this in CI).
 *
 *   0 HOME    default. Lock / screenshots. Reboot, deep sleep and leaving GAME land here.
 *   1 GAME    left half only, all three thumbs are game keys, no layer key except the
 *             2.2 s hold-to-exit on the Esc key.
 *   2 OBS     scene / record / stream / audio keys, sent as Ctrl+Shift+Alt+F13..F21
 *             (see docs/macropad.md for the chord table).
 *   3 MACROS  GUI+Space and tmux prefix chords (prefix = C-Space, see the user's tmux.conf).
 *   4 PICK    reached by HOLDING the left middle thumb on HOME / OBS / MACROS;
 *             tap a key to jump to a layer.
 *
 * Esc is the top-left key on every layer. Unused keys are &none.
 * The previous typing keymap is kept in git under the tag typing-v1.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/* NB: not HOME/OBS/...: HOME is already the Home keycode in keys.h */
#define L_HOME  0
#define L_GAME  1
#define L_OBS   2
#define L_MACRO 3
#define L_PICK  4

/* "Meh" chord (Ctrl+Shift+Alt+key): unique, collision-free keys for OBS / host scripts */
#define MEH(k) LC(LS(LA(k)))

/ {
    behaviors {
        /* Esc key on GAME: tap = Esc, hold 2.2 s = back to HOME.
         * tap-preferred: no other key press can turn this into the hold, only the timer.
         * Releasing before 2.2 s sends Esc. */
        game_exit: game_exit {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <2200>;
            bindings = <&to>, <&kp>;
        };

        /* guard for keys you must not hit by accident (STREAM): hold 0.7 s to fire,
         * a plain tap does nothing. Usage: &hold_kp <keycode> 0   (0 = dummy tap param) */
        hold_kp: hold_kp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <700>;
            bindings = <&kp>, <&none>;
        };
    };

    /* tmux prefix is C-Space. Explicit gaps so the two keys never depend on defaults. */
    macros {
        m_tmux_session: m_tmux_session {        /* prefix s : fzf session switch */
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LC(SPACE) &kp S>;
        };
        m_tmux_scratchpad: m_tmux_scratchpad {  /* prefix C-n : tpad scratchpad */
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LC(SPACE) &kp LC(N)>;
        };
        m_tmux_lazygit: m_tmux_lazygit {        /* prefix C-g : tpad lazygit */
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LC(SPACE) &kp LC(G)>;
        };
        m_tmux_tpm_install: m_tmux_tpm_install { /* prefix I : tpm install plugins */
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <30>; tap-ms = <30>;
            bindings = <&kp LC(SPACE) &kp LS(I)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* ===================================== HOME =====================================
         *  ESC   .    .    .    .   SHOT-WIN |  .  .  .  .  .  .
         *  LOCK  .    .    .    .   SHOT-MAC |  .  .  .  .  .  .
         *  .     .    .    .    .   SHOT-LNX |  .  .  .  .  .  .
         *             .  [PICK]  .           |  .  .  .
         *  LOCK = Win+L.  Screenshots: Win+Shift+S / Cmd+Shift+4 / PrintScreen (flameshot)
         * ============================================================================== */
        home_layer {
            display-name = "HOME";
            bindings = <
   &kp ESC      &none  &none  &none  &none  &kp LG(LS(S))     &none  &none  &none  &none  &none  &none
   &kp LG(L)    &none  &none  &none  &none  &kp LG(LS(N4))    &none  &none  &none  &none  &none  &none
   &none        &none  &none  &none  &none  &kp PSCRN         &none  &none  &none  &none  &none  &none
                              &none  &mo L_PICK  &none        &none  &none  &none
            >;
        };

        /* ===================================== GAME =====================================
         *  ESC*  Q    W    E    R    T  |  .  .  .  .  .  .     * tap = Esc, hold 2.2 s = HOME
         *  TAB   A    S    D    F    G  |  .  .  .  .  .  .
         *  LSFT  .    X    C    M    B  |  .  .  .  .  .  .
         *            LCTRL  LALT  SPACE |  .  .  .
         *  No layer / output / system key on this layer except the Esc hold-to-exit.
         * ============================================================================== */
        game_layer {
            display-name = "GAME";
            bindings = <
   &game_exit L_HOME ESC  &kp Q    &kp W  &kp E  &kp R  &kp T         &none  &none  &none  &none  &none  &none
   &kp TAB                &kp A    &kp S  &kp D  &kp F  &kp G         &none  &none  &none  &none  &none  &none
   &kp LSHFT              &kp DOT  &kp X  &kp C  &kp M  &kp B         &none  &none  &none  &none  &none  &none
                                   &kp LCTRL  &kp LALT  &kp SPACE     &none  &none  &none
            >;
        };

        /* ===================================== OBS ======================================
         *  ESC  SCENE1 SCENE2 SCENE3  .  . |  .  .  .  .  .  .
         *  .    REC    PAUSE  STREAM* .  . |  .  .  .  .  .  .
         *  .    MIC    DESK   REPLAY  .  . |  .  .  .  .  .  .
         *            .     [PICK]    .     |  .  .  .
         *  Chords Ctrl+Shift+Alt+F13..F21 (F13-15 scenes, F16 rec, F17 pause, F18 stream,
         *  F19 mic, F20 desktop audio, F21 replay). * = hold 0.7 s.
         * ============================================================================== */
        obs_layer {
            display-name = "OBS";
            bindings = <
   &kp ESC  &kp MEH(F13)  &kp MEH(F14)  &kp MEH(F15)            &none  &none     &none  &none  &none  &none  &none  &none
   &none    &kp MEH(F16)  &kp MEH(F17)  &hold_kp MEH(F18) 0     &none  &none     &none  &none  &none  &none  &none  &none
   &none    &kp MEH(F19)  &kp MEH(F20)  &kp MEH(F21)            &none  &none     &none  &none  &none  &none  &none  &none
                                  &none  &mo L_PICK  &none                       &none  &none  &none
            >;
        };

        /* ==================================== MACROS ====================================
         *  ESC  GUI+SPC   .         .             .          .  |  .  .  .  .  .  .
         *  .    T-PFX     T-SESS    T-SCRATCH     T-LAZYGIT  .  |  .  .  .  .  .  .
         *  .    .         T-TPM-I   .             .          .  |  .  .  .  .  .  .
         *             .     [PICK]     .                       |  .  .  .
         * ============================================================================== */
        macro_layer {
            display-name = "MACROS";
            bindings = <
   &kp ESC  &kp LG(SPACE)   &none                &none                  &none               &none     &none  &none  &none  &none  &none  &none
   &none    &kp LC(SPACE)   &m_tmux_session      &m_tmux_scratchpad     &m_tmux_lazygit     &none     &none  &none  &none  &none  &none  &none
   &none    &none           &m_tmux_tpm_install  &none                  &none               &none     &none  &none  &none  &none  &none  &none
                                      &none  &mo L_PICK  &none                                       &none  &none  &none
            >;
        };

        /* ===================================== PICK =====================================
         *  Hold the left middle thumb, tap a target:  S = HOME  D = GAME  F = OBS  G = MACROS
         * ============================================================================== */
        pick_layer {
            display-name = "PICK";
            bindings = <
   &kp ESC  &none  &none        &none        &none       &none          &none  &none  &none  &none  &none  &none
   &none    &none  &to L_HOME   &to L_GAME   &to L_OBS   &to L_MACRO    &none  &none  &none  &none  &none  &none
   &none    &none  &none        &none        &none       &none          &none  &none  &none  &none  &none  &none
                                &none  &none  &none                     &none  &none  &none
            >;
        };
    };
};
