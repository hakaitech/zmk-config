/*
 * Corne (crkbd) keymap  --  ported from a Dygma Defy "Defy" layout
 * 4-layer system:  0 = BASE (QWERTY)   1 = SYM (symbols/numbers)   2 = NAV (macros/arrows)
 *                  3 = FN (F-keys / page-nav / system), held SYM + NAV together
 *
 * Thumb mods (no home-row mods):
 *   left  thumbs:  [RCTRL]  [Enter / hold=NAV]   [SPACE]
 *   right thumbs:  [SPACE]  [Enter / hold=LALT]  [GUI]
 *   Enter is on BOTH middle thumbs: the left one holds for the NAV layer,
 *   the right one holds for Left Alt. Both use the same balanced hold-tap.
 *   Shift lives on the left outer column (base).
 *
 * ZMK Studio ready: every macro below is compiled into the firmware, so you can
 * re-assign any of them to any key live in ZMK Studio without reflashing.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

#define BASE 0
#define SYM  1
#define NAV  2
#define FN   3

/ {
    /* ------------------------------------------------------------------ *
     *  BEHAVIORS                                                          *
     * ------------------------------------------------------------------ */
    behaviors {
        /* colon/semicolon hold-tap:  tap = ':'   hold = ';' */
        scln: scln {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* generic punctuation hold-tap:  tap = base symbol, hold = shifted symbol.
         * used for  ' / "  and  - / _  (same idea as the colon key above) */
        htp: htp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* esc/backtick hold-tap:  tap = Esc   hold = ` (GRAVE) */
        esc_grv: esc_grv {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        /* thumb layer-tap:  tap = Enter   hold = NAV layer.
         * "balanced": a held thumb + tapped nav key resolves to the layer,
         * while a quick tap stays Enter. */
        lt_nav: lt_nav {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };

        /* thumb mod-tap:  tap = Enter   hold = Left Alt.
         * Mirror of lt_nav on the opposite thumb -- same balanced flavor, tapping
         * term and quick-tap guard, so both Enter keys behave identically.
         * Deliberately not ZMK's built-in &mt, which is hold-preferred and would
         * fire Alt on any key pressed while the thumb is still down. */
        ret_alt: ret_alt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };
    };

    /* ------------------------------------------------------------------ *
     *  CONDITIONAL LAYERS                                                 *
     * ------------------------------------------------------------------ */
    conditional_layers {
        compatible = "zmk,conditional-layers";

        /* SYM (right pinky) + NAV (left thumb) held together -> FN */
        sym_nav_fn {
            if-layers = <SYM NAV>;
            then-layer = <FN>;
        };
    };

    /* ------------------------------------------------------------------ *
     *  MACROS  (decoded 1:1 from your Defy macros.map)                    *
     * ------------------------------------------------------------------ */
    macros {
        /* ---- vim ---- */
        m_vim_q: m_vim_q {                     // :q<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LS(SEMI) &kp Q &kp RET>;
        };
        m_vim_w: m_vim_w {                     // :w<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LS(SEMI) &kp W &kp RET>;
        };
        m_vim_rla: m_vim_rla {                 // :rla<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LS(SEMI) &kp R &kp L &kp A &kp RET>;
        };

        /* ---- IDE  (Ctrl+Space chords) ---- */
        m_cs_j: m_cs_j {                       // Ctrl+Space then J
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp J>;
        };
        m_cs_pct: m_cs_pct {                   // Ctrl+Space then %
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LS(N5)>;
        };
        m_cs_dq: m_cs_dq {                     // Ctrl+Space then "
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp LS(SQT)>;
        };
        m_cs_p: m_cs_p {                       // Ctrl+Space then p
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LC(SPACE) &kp P>;
        };
        m_sp_f: m_sp_f {                       // Space then Shift+F
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp SPACE &kp LS(F)>;
        };

        /* ---- i3 / window manager ---- */
        m_i3lock: m_i3lock {                   // types: i3lock<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp I &kp N3 &kp L &kp O &kp C &kp K &kp RET>;
        };

        /* ---- Slack / Discord slash-commands ---- */
        m_checklist: m_checklist {             // /checklist<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp FSLH &kp C &kp H &kp E &kp C &kp K &kp L &kp I &kp S &kp T &kp RET>;
        };
        m_banner_green: m_banner_green {        // <GUI+Left> /banner green<CR> <GUI+Right>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp FSLH &kp B &kp A &kp N &kp N &kp E &kp R &kp SPACE
                        &kp G &kp R &kp E &kp E &kp N &kp RET &kp LG(RIGHT)>;
        };
        m_banner_red: m_banner_red {            // <GUI+Left> /banner red<CR> <GUI+Right>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp FSLH &kp B &kp A &kp N &kp N &kp E &kp R &kp SPACE
                        &kp R &kp E &kp D &kp RET &kp LG(RIGHT)>;
        };
        m_banner_blue: m_banner_blue {          // <GUI+Left> /banner blue<CR> <GUI+Right>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp LG(LEFT) &kp FSLH &kp B &kp A &kp N &kp N &kp E &kp R &kp SPACE
                        &kp B &kp L &kp U &kp E &kp RET &kp LG(RIGHT)>;
        };
        m_giphy: m_giphy {                      // /giphy <pause> <CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            wait-ms = <40>;
            bindings = <&kp FSLH &kp G &kp I &kp P &kp H &kp Y &kp RET>;
        };
        m_green: m_green {                      // green<CR>
            compatible = "zmk,behavior-macro"; #binding-cells = <0>;
            bindings = <&kp G &kp R &kp E &kp E &kp N &kp RET>;
        };
    };

    /* ------------------------------------------------------------------ *
     *  KEYMAP                                                             *
     * ------------------------------------------------------------------ */
    keymap {
        compatible = "zmk,keymap";

        /* ================================ BASE / QWERTY ==================================
         *  ESC  Q   W   E   R   T   |   Y   U   I   O   P   BSPC   (ESC: tap / ` hold)
         *  TAB  A   S   D   F   G   |   H   J   K   L   :   DEL   (: tap / ; hold)
         *  SFT  Z   X   C   V   B   |   N   M   ,   .   /   MO(SYM)
         *          RCTRL  ENT/NAV  SPC   |  SPC  ENT/ALT  GUI
         *          (left mid: tap Enter / hold NAV;  right mid: tap Enter / hold LAlt)
         * ============================================================================== */
        base_layer {
            display-name = "BASE";
            bindings = <
   &esc_grv GRAVE ESC  &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U  &kp I      &kp O    &kp P     &kp BSPC
   &kp TAB    &kp A  &kp S  &kp D  &kp F  &kp G        &kp H  &kp J  &kp K      &kp L    &scln SEMI LS(SEMI)  &kp DEL
   &kp LSHFT  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH  &mo SYM
                     &kp RCTRL  &lt_nav NAV RET  &kp SPACE    &kp SPACE  &ret_alt LALT RET  &kp LGUI
            >;
        };

        /* ================================ SYM / numbers ==================================
         *  (outer columns transparent -> Esc/Tab/Shift & Bspc/Del still work)
         *   .   1   2   3   4   5   |   6   7   8   9   0    .
         *   .   !   @   #   $   %   |   ^   &   *   (   )    .
         *   .   =  -/_  \   `  '/"  |   [   ]   {   }   ?    .   (- tap/_ hold ; ' tap/" hold ; ? = shift+/)
         * ============================================================================== */
        sym_layer {
            display-name = "SYM";
            bindings = <
   &trans  &kp N1        &kp N2        &kp N3     &kp N4      &kp N5           &kp N6     &kp N7     &kp N8        &kp N9        &kp N0         &trans
   &trans  &kp LS(N1)    &kp LS(N2)    &kp LS(N3) &kp LS(N4)  &kp LS(N5)       &kp LS(N6) &kp LS(N7) &kp LS(N8)    &kp LS(N9)    &kp LS(N0)     &trans
   &trans  &kp EQUAL     &htp LS(MINUS) MINUS  &kp BSLH   &kp GRAVE   &htp LS(SQT) SQT  &kp LBKT   &kp RBKT   &kp LBRC      &kp RBRC      &kp LS(FSLH)   &trans
                                       &trans  &trans  &kp SPACE      &kp SPACE  &trans  &trans
            >;
        };

        /* ================================ NAV / macros ===================================
         *  No F-keys (those live on FN). Left macros shifted up one row. The left bottom
         *  row is blanked (&none) so nothing fires by accident, apart from PrintScreen on
         *  the C column -- "C for capture", one thumb hold away. Right top row = media keys.
         *  left hand = your Defy macros            right hand = media / arrows / ctrl-chords
         *   .   :q   :w   csJ  cs%  cs"  |  PREV  PLAY  NEXT  VOL- VOL+   .
         *   .   gui< gui> gui^ guiv g+SQ |  LEFT  DOWN  UP    RIGHT csP    .
         *   .   --   --   PSCR --   --   |  C+S   C+W   C+D   C+INS INS    .
         * ============================================================================== */
        nav_layer {
            display-name = "NAV";
            bindings = <
   &trans  &m_vim_q      &m_vim_w      &m_cs_j    &m_cs_pct       &m_cs_dq        &kp C_PREV  &kp C_PP   &kp C_NEXT  &kp C_VOL_DN  &kp C_VOL_UP  &trans
   &trans  &kp LG(LEFT)  &kp LG(RIGHT) &kp LG(UP) &kp LG(DOWN)    &kp LG(LS(Q))   &kp LEFT    &kp DOWN   &kp UP      &kp RIGHT     &m_cs_p       &trans
   &trans  &none         &none         &kp PSCRN  &none           &none           &kp LC(S)   &kp LC(W)  &kp LC(D)   &kp LC(INS)   &kp INS       &trans
                                  &trans  &trans  &kp SPACE      &kp SPACE  &trans  &trans
            >;
        };

        /* ================================= FN / F-keys ===================================
         *  Conditional layer: active only while SYM and NAV are BOTH held.
         *  Outer columns stay transparent -> Esc/Tab/Shift and Bspc/Del still work.
         *  Thumbs stay transparent too, so Ctrl / Alt / GUI / Space remain live here.
         *  Left bottom row is blanked (&none), same rule as NAV.
         *   .   F1   F2   F3   F4   F5  |  F6     F7     F8    F9   F10   .
         *   .   F11  F12  --   --   --  |  HOME   PGDN   PGUP  END  --    .
         *   .   --   --   --   --   --  |  PSCRN  PAUSE  MENU  --   --    .
         *  Page-nav sits on the same row and finger order as NAV's LEFT/DOWN/UP/RIGHT.
         * ============================================================================== */
        fn_layer {
            display-name = "FN";
            bindings = <
   &trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5      &kp F6     &kp F7           &kp F8     &kp F9   &kp F10  &trans
   &trans  &kp F11  &kp F12  &none   &none   &none       &kp HOME   &kp PG_DN        &kp PG_UP  &kp END  &none    &trans
   &trans  &none    &none    &none   &none   &none       &kp PSCRN  &kp PAUSE_BREAK  &kp K_APP  &none    &none    &trans
                             &trans  &trans  &trans      &trans     &trans           &trans
            >;
        };
    };
};
